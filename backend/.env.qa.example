# LifeLens backend — QA environment template.
# QA and PROD share the SAME single Supabase project and SAME single Gemini key.
# Real values are injected by CI (GitHub Environment `qa`) / Railway. NEVER commit real values.

APP_ENV=qa
DEBUG=true

# CORS (JSON array — the setting is list[str])
CORS_ORIGINS=["https://api-qa.lifelens.app"]

DATABASE_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STORAGE_BUCKET=

AI_PROVIDER=gemini
AI_MODEL_GEMINI=gemini-3.5-flash-lite
GOOGLE_AI_API_KEY=
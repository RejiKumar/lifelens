# LifeLens backend configuration.
# Copy to `.env` for local development. NEVER commit real values.

# App
APP_ENV=dev
DEBUG=false

# CORS (comma-separated origins)
CORS_ORIGINS=*

# Supabase / database (session mode, port 5432)
DATABASE_URL=

# Supabase (set server-side only, never in client)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (Gemini) — used by ai-analysis change, not yet
GEMINI_API_KEY=
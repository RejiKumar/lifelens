# LifeLens backend configuration.
# Copy to `.env` for local development. NEVER commit real values.

# App
APP_ENV=dev
DEBUG=false

# CORS (JSON array — the setting is list[str])
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# Supabase / database (session mode, port 5432)
DATABASE_URL=

# Supabase (set server-side only, never in client)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STORAGE_BUCKET=

# AI provider (Gemini). Set AI_PROVIDER=gemini to use the real provider,
# or leave as stub for local/tests (no key required).
AI_PROVIDER=stub
AI_MODEL_GEMINI=gemini-3.5-flash-lite
GOOGLE_AI_API_KEY=